# 資料庫連線 (SQLite 檔案)
DATABASE_URL="file:./dev.db"

# GitHub Personal Access Token (選填，提高 API 限額至每小時 5,000 次)
# 取得方式：GitHub -> Settings -> Developer settings -> Personal access tokens
# 注意：此 Token 僅在伺服器端 (Next.js Server / API Routes) 使用，絕不暴露至前端
GITHUB_TOKEN=

# AI 摘要 API Key (選填，支援可選的進階智慧解讀，若未設定則自動啟用規則式中文解讀)
AI_API_KEY=
AI_API_ENDPOINT=

# 應用程式環境
NODE_ENV=development
PORT=3000
