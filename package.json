{
  "name": "github-explorer-v2",
  "version": "2.0.0",
  "private": true,
  "main": "electron/main.js",
  "description": "開源專案雷達 - Discover What's Rising in Open Source",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "electron:dev": "electron .",
    "electron:build": "node scripts/repair-electron-types.js && next build && node scripts/copy-standalone.js",
    "dist:win": "npm run electron:build && electron-builder --win",
    "dist:win:dir": "npm run electron:build && electron-builder --win --dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "^5.11.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.358.0",
    "next": "^14.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "@testing-library/react": "^14.2.1",
    "@types/node": "^20.11.28",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "autoprefixer": "^10.4.18",
    "cross-env": "^7.0.3",
    "electron": "^29.1.5",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "prisma": "^5.11.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vitest": "^1.4.0"
  }
}
