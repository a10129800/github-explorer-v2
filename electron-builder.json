{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.antigravity.github-explorer-v2",
  "productName": "GitHub Explorer V2",
  "copyright": "Copyright © 2026 Antigravity Team",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": ".next/standalone",
      "to": "standalone",
      "filter": [
        "**/*",
        "!**/*.map"
      ]
    },
    {
      "from": ".next/standalone/node_modules",
      "to": "standalone/node_modules",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "prisma/schema.prisma",
      "to": "prisma/schema.prisma"
    },
    {
      "from": "build/icon.ico",
      "to": "icon.ico"
    }
  ],
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "GitHub-Explorer-Setup.exe"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "GitHub Explorer V2",
    "uninstallDisplayName": "GitHub Explorer V2",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true,
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerHeaderIcon": "build/icon.ico"
  }
}
